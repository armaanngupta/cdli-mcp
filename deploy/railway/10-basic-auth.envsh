#!/bin/sh
# Runs before nginx starts. Must be .envsh, not .sh: the nginx image *sources* .envsh files
# and *executes* .sh ones, and an exported variable from a subshell would never reach the
# envsubst step that renders the config.
#
# A public URL wired to LLM providers is abusable, so the demo sits behind HTTP Basic Auth.
# The credential is supplied as a ready-made htpasswd line in BASIC_AUTH, so no hash is
# baked into the image; leave it unset and the site is open, which is fine locally.
set -eu

: "${PORT:=8080}"

# nginx needs an explicit resolver because the upstreams live in variables (so one service
# restarting cannot take nginx down with it). Railway does not document its internal DNS
# address, so take whatever the platform already put in resolv.conf rather than making the
# operator hunt for it. IPv6 addresses have to be bracketed in the resolver directive.
if [ -z "${DNS_RESOLVER:-}" ]; then
  DNS_RESOLVER=$(awk '/^nameserver/ { print $2; exit }' /etc/resolv.conf 2>/dev/null || true)
  : "${DNS_RESOLVER:=8.8.8.8}"
  case "$DNS_RESOLVER" in
    *:*) DNS_RESOLVER="[$DNS_RESOLVER]" ;;
  esac
fi
echo "dns resolver: $DNS_RESOLVER"

if [ -n "${BASIC_AUTH:-}" ]; then
  printf '%s\n' "$BASIC_AUTH" > /etc/nginx/.htpasswd
  # envsubst needs a value even when auth is off, hence a quoted realm rather than empty.
  AUTH_BASIC='"CDLI demo"'
  echo "basic auth: enabled"
else
  : > /etc/nginx/.htpasswd
  AUTH_BASIC="off"
  echo "basic auth: disabled (BASIC_AUTH not set)"
fi

export PORT DNS_RESOLVER AUTH_BASIC
