# Rendered by the nginx image's envsubst at container start. Only variables that exist in
# the environment are substituted, so nginx's own $host / $uri / $scheme are left alone.
#
# Railway terminates TLS at its edge, so this listens on plain HTTP.

server {
  listen ${PORT};
  listen [::]:${PORT};
  server_name _;
  root /usr/share/nginx/html;

  # Applied to every location below via inheritance. 10-basic-auth.sh writes the password
  # file and sets AUTH_BASIC to "off" when no credentials are configured.
  auth_basic ${AUTH_BASIC};
  auth_basic_user_file /etc/nginx/.htpasswd;

  # Railway's private DNS. Resolved at request time because the upstream is held in a
  # variable, which is what allows a service to restart without taking nginx down with it.
  resolver ${DNS_RESOLVER} valid=10s;

  location ^~ /chat/api/ {
    set $chat_backend "http://${CHAT_BACKEND_HOST}";
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;

    # SSE: without these the stream is buffered and nothing appears until the turn ends,
    # and a /paper run dies at nginx's 60s default read timeout.
    proxy_http_version 1.1;
    proxy_set_header Connection "";
    proxy_buffering off;
    proxy_cache off;
    chunked_transfer_encoding off;
    proxy_read_timeout 1800s;
    proxy_send_timeout 1800s;

    proxy_pass $chat_backend;
  }

  location ^~ /mcp {
    set $mcp "http://${MCP_HOST}";
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;

    # Streamable HTTP responses are SSE too.
    proxy_http_version 1.1;
    proxy_set_header Connection "";
    proxy_buffering off;
    proxy_read_timeout 600s;

    proxy_pass $mcp;
  }

  location / {
    try_files $uri $uri/ /index.html;
  }

  location /assets/ {
    expires 1y;
    add_header Cache-Control "public, immutable";
  }
}
