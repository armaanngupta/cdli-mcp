{
  "name": "cdli-mcp",
  "version": "0.1.0",
  "description": "CDLI MCP monorepo — MCP server (Phase 1) and chat interface (Phase 2)",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build -w @cdli/server",
    "dev": "npm run dev -w @cdli/server",
    "lint": "npm run lint -w @cdli/server",
    "format": "npm run format -w @cdli/server",
    "test": "npm run test -w @cdli/server",
    "inspect": "npm run inspect -w @cdli/server",
    "dev:http": "npm run dev:http -w @cdli/server",
    "serve": "npm run serve -w @cdli/server"
  }
}
