# Port the chat backend listens on
PORT=8090

# URL of the CDLI MCP server (internal address in production, localhost in dev)
MCP_URL=http://localhost:3000/mcp

# HMAC secret shared with the CakePHP framework's GET /chat/token action (not yet built).
# Must match exactly on both sides — a JWT signed with one won't verify against the other.
CHAT_IDENTITY_SECRET=

# CDLI-funded Mistral key for logged-in users without their own key (plan §9.2).
# Never exposed to the client — resolved server-side only, per request, in llm/credentials.ts.
FUNDED_MISTRAL_API_KEY=

# URL of the Python paper agent (agent-paper). /chat/api/paper proxies its SSE stream.
# BYOM-only: the funded key above is never used for a paper run.
PAPER_URL=http://localhost:8100
