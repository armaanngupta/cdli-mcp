# Copy to .env and adjust. All variables are optional — sensible defaults apply.

# HTTP transport (src/index-http.ts, src/transports/http.ts)
# Port for the Streamable HTTP server.
PORT=3000
# Comma-separated allowlist of Host HOSTNAMES (no ports — the check is port-agnostic)
# for DNS-rebinding protection. Leave unset to disable the check (e.g. local dev).
# ALLOWED_HOSTS=mcp.cdli.earth,localhost,127.0.0.1

# cqp_query tool (src/tools/cqp_query.ts)
# Base URL of the CQP4RDF query API. Defaults to the deployed CDLI endpoint.
# Point at a local instance for testing while the deployed one is unstable.
# CQP_BASE_URL=http://localhost:2454/cqp4rdf/api/query
